# Base de datos PostgreSQL. En local: npm run db:up (Docker). En Vercel las crea la integración de Neon.
DATABASE_URL="postgresql://servicio:servicio@localhost:5432/servicio_social"
DATABASE_URL_UNPOOLED="postgresql://servicio:servicio@localhost:5432/servicio_social"
# Cadena aleatoria larga para firmar sesiones (openssl rand -hex 32)
SESSION_SECRET="cambia-esto"
# Organización que se muestra en la raíz del sitio
DEFAULT_ORG="reyhan"
# 1 = cargar datos de ejemplo en el primer despliegue (solo si la base está vacía)
SEED_DEMO="1"
# Asistente de IA
IA_API_KEY=""
# Identificador del modelo de IA del proveedor
IA_MODELO=""
